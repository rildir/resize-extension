{
  "manifest_version": 3,
  "name": "PageEraser",
  "description": "Erase any element from any page, X-Ray layouts, extract components to code, overlay designs. All local, no tracking.",
  "version": "1.11.1",
  "minimum_chrome_version": "102",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "contextMenus"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "start-selection": {
      "suggested_key": {
        "default": "Alt+Shift+E",
        "mac": "Alt+Shift+E"
      },
      "description": "Start selection mode"
    },
    "reset-layout": {
      "suggested_key": {
        "default": "Alt+Shift+D",
        "mac": "Alt+Shift+D"
      },
      "description": "Restore all layout changes on this site"
    },
    "start-paint": {
      "suggested_key": {
        "default": "Alt+Shift+W",
        "mac": "Alt+Shift+W"
      },
      "description": "Start paintbrush 95 mode"
    },
    "toggle-xray": {
      "suggested_key": {
        "default": "Alt+Shift+X",
        "mac": "Alt+Shift+X"
      },
      "description": "Toggle Layout X-Ray"
    },
    "toggle-extract": {
      "description": "Toggle Extract to Code"
    },
    "toggle-diff": {
      "description": "Toggle Visual Diff"
    }
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "shared.js",
        "modes/index.js",
        "modes/erase.js",
        "modes/xray.js",
        "modes/extract-core.js",
        "modes/extract.js",
        "modes/diff-core.js",
        "modes/diff.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start"
    }
  ]
}
